#!/usr/bin/env python3
"""Find a declaration in the std that ships with the zig you are using.

    zig-lookup heap.GeneralPurposeAllocator
    zig-lookup Io.Dir.readFileAlloc
    zig-lookup Mutex

Prints the signature and doc comment when the name exists. When it does not,
prints what the parent namespace does contain and where else in std the name
or a close one lives, which is what a `no member named` error leaves out.
"""
import difflib
import os
import re
import shutil
import subprocess
import sys

DECL = re.compile(r"^(\s*)pub (?:inline |extern |export )*(?:const|var|fn) (@\"[^\"]+\"|\w+)")
IMPORT = r'^pub const %s(?::[^=]+)? = @import\("([^"]+)"\)'


def find_zig():
    for cand in (os.environ.get("ZIG"), shutil.which("zig")):
        if cand and os.path.exists(cand):
            return cand
    sys.exit("zig-lookup: no zig found. Set ZIG=/path/to/zig.")


def std_dir(zig):
    out = subprocess.run([zig, "env"], capture_output=True, text=True).stdout
    m = re.search(r'std_dir"?\s*[=:]\s*"([^"]+)"', out)
    if not m:
        sys.exit("zig-lookup: could not read std_dir from `zig env`.")
    return m.group(1)


def read(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read().split("\n")


def decls(lines, indent_max=0):
    """(line index, name) for public declarations at or above an indent."""
    out = []
    for i, line in enumerate(lines):
        m = DECL.match(line)
        if m and len(m.group(1)) <= indent_max:
            out.append((i, m.group(2)))
    return out


def show(path, lines, i, root):
    start = i
    while start > 0 and lines[start - 1].lstrip().startswith("///"):
        start -= 1
    start = max(start, i - 8)
    end = i
    while end < len(lines) - 1 and end - i < 14 and not re.search(r"[{;]\s*$", lines[end]):
        end += 1
    print(f"{os.path.relpath(path, root)}:{i + 1}")
    for line in lines[start : end + 1]:
        print("    " + line.rstrip())
    print()


def walk(root, parts):
    """Follow `pub const x = @import(...)` from std.zig as far as it goes."""
    path = os.path.join(root, "std.zig")
    used = 0
    for seg in parts:
        hit = None
        for line in read(path):
            m = re.match(IMPORT % re.escape(seg), line)
            if m:
                hit = os.path.normpath(os.path.join(os.path.dirname(path), m.group(1)))
                break
        if not hit or not os.path.exists(hit):
            break
        path, used = hit, used + 1
    return path, parts[used:]


def everywhere(root, name):
    hits = []
    for dirpath, _, files in os.walk(root):
        for f in sorted(files):
            if not f.endswith(".zig"):
                continue
            p = os.path.join(dirpath, f)
            lines = read(p)
            for i, n in decls(lines, indent_max=8):
                if n == name:
                    hits.append((p, lines, i))
    return hits


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        sys.exit(__doc__.strip())
    zig = find_zig()
    root = std_dir(zig)
    parts = [p for p in sys.argv[1].split(".") if p and p != "std"]
    name = parts[-1]
    path, rest = walk(root, parts)
    lines = read(path)

    if not rest:
        print(f"{os.path.relpath(path, root)} is the namespace `{sys.argv[1]}`. Public decls:")
        print("    " + " ".join(sorted({n for _, n in decls(lines)})))
        return

    found = [i for i, n in decls(lines, indent_max=8) if n == name]
    if found:
        for i in found[:3]:
            show(path, lines, i, root)
        return

    rel = os.path.relpath(path, root)
    print(f"`{name}` is not in {rel} (zig {subprocess.run([zig, 'version'], capture_output=True, text=True).stdout.strip()}).\n")
    hits = [h for h in everywhere(root, name) if h[0] != path]
    if hits:
        print(f"Declared elsewhere in std ({len(hits)}):")
        for p, ls, i in hits[:4]:
            show(p, ls, i, root)
    here = sorted({n for _, n in decls(lines)})
    close = difflib.get_close_matches(name, here, n=6, cutoff=0.5)
    if close:
        print(f"Close names in {rel}: " + " ".join(close))
    print(f"Public decls in {rel}:")
    print("    " + " ".join(here))


if __name__ == "__main__":
    main()
